# AI 이야기 — 아래 둘 중 하나의 키만 있어도 됩니다. (둘 다 없으면 각본 모드로 동작)
# 둘 다 있으면 OpenAI가 우선이며, AI_PROVIDER=openai 또는 anthropic 으로 직접 고를 수 있습니다.
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI 모델과 추론 노력 수준 (추론 모델이 아니면 OPENAI_REASONING_EFFORT를 비워 두세요)
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
# 새 사설을 읽는 AI 목소리(OpenAI 음성 합성, 실험용 — 노래가 아니라 낭독에 가까움). 1이면 켬
OPENAI_VOICE_MODEL=gpt-4o-mini-tts
SORISKETCH_VOICE=0

# Claude 모델과 생성 노력 수준
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# 1로 두면 키가 있어도 AI를 끕니다 (오프라인 시연용)
SORISKETCH_OFFLINE=0
# IP당 10분에 허용할 AI 요청 수
SORISKETCH_RATE_LIMIT=40
PORT=3000
